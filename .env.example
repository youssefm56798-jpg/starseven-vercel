# ---- Database (Neon) -------------------------------------------------------
# Vercel → Storage → Neon fills these in automatically when you connect the DB.
DATABASE_URL="postgresql://user:password@host.neon.tech/starseven?sslmode=require"
# The direct endpoint, without the pooler. Only the verify:* scripts use it —
# CREATE DATABASE is refused through a pooler, and those scripts each build a
# throwaway database so they never touch this one.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/starseven?sslmode=require"

# The restricted role the RUNNING SITE connects as. Optional: absent, the site
# falls back to DATABASE_URL. Same connection string, different user/password.
# See docs/DEPLOY.md and db/grants.mjs.
DATABASE_URL_APP=""

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://newstarseven.com"
NEXT_PUBLIC_WHATSAPP="201028282216"
SHIPPING_FEE="30"
FREE_DELIVERY_OVER="300"

# How long an order nobody has confirmed keeps holding its stock, in hours.
# Past this, /api/cron/release cancels it, which puts the stock back and returns
# any coupon redemption. This is what stops a flood of fake cash-on-delivery
# orders taking the whole catalogue to "out of stock" permanently — there is no
# payment step to stop them being placed, so the defence is that they expire.
# Set well past the slowest honest call-back; see lib/config.js. 0 turns the
# sweep off entirely and restores the old behaviour, which is stock held for
# ever.
ORDER_HOLD_HOURS="72"

# Authorises the scheduled sweep above. Vercel Cron sends it as
# `Authorization: Bearer <this>`, but ONLY when it is set — so with this unset
# the sweep refuses every request, including the scheduler's, and stock stops
# being released. Generate, do not invent:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="replace_with_the_output_of_the_command_above"

# How long an order gets when the customer WAS warned - the WhatsApp
# confirmation reached them and they did not answer. Shorter than
# ORDER_HOLD_HOURS above, which is what an order gets when the message never
# arrived, because cancelling somebody who was never told is the unfairness the
# warning exists to prevent. 12 rather than 6 because six hours cancels a 2am
# order before its customer has woken up.
ORDER_WARNED_HOLD_HOURS="12"

# ---- WhatsApp order confirmation (Meta Cloud API) --------------------------
# Optional. Absent, nothing is sent, no reply can be verified, and every order
# falls back to ORDER_HOLD_HOURS - which is exactly how the shop behaved before
# any of this existed, so leaving these unset is a safe no-op.
#
# WHATSAPP_APP_SECRET is the App Secret from the Meta app dashboard. It is the
# ONLY thing guarding /api/whatsapp/webhook, which is a public URL that can mark
# an order verified and cancel it: with this unset the webhook refuses every
# request, which is deliberate and is the safe direction to fail.
WHATSAPP_APP_SECRET=""
# A string you invent. Meta echoes it back once, when the webhook URL is first
# saved, to prove you own the endpoint. Generate, do not invent:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WHATSAPP_VERIFY_TOKEN=""

# ---- Analytics -------------------------------------------------------------
# Optional. Google Analytics 4. Absent, no GA script loads, the CSP in
# next.config.mjs carries no Google hosts, and the privacy policy prints no
# Google paragraph - all three read this same variable at BUILD time, so setting
# it and redeploying moves all three together.
#
# Know what setting it does before you set it: GA4 puts _ga cookies on every
# visitor, which is the difference between a site that gives customers no
# cookies and one that does. docs/LEGAL-BRIEF.md Q3 asks the lawyer whether that
# needs a consent banner under Egyptian law; the honest answer today is that
# nobody has answered it yet.
NEXT_PUBLIC_GA_ID=""

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM="orders@newstarseven.com"
MAIL_FROM_NAME="New Star Seven"
ORDER_NOTIFY_TO="orders@newstarseven.com"

# ---- Product images (Vercel Blob) -------------------------------------------
# Set automatically once a Blob store is connected in Vercel -> Storage.
# Without it the admin still adds, edits and archives products - it just cannot
# take an upload, and the image field falls back to the path of a file
# committed under public/, which is where the whole existing catalogue lives.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ---- Admin -----------------------------------------------------------------
# Long random string. Signs the admin login cookie.
# Generate, do not invent: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# It signs every admin session AND derives the key that seals every TOTP secret.
SESSION_SECRET="replace_with_the_output_of_the_command_above"
# Used once by /admin/setup to create the first login, then remove it.
ADMIN_SETUP_KEY="change_me_too"
