# ---- Admin -----------------------------------------------------------------
# Long random string. Signs the admin login cookie.
SESSION_SECRET="change_me_to_a_long_random_string"
# Used once by /admin/setup to create the first login, then remove it.
ADMIN_SETUP_KEY="change_me_too"
