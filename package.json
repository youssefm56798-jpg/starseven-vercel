{
  "name": "starseven-store",
  "version": "1.0.0",
  "private": true,
  "description": "New Star Seven — storefront, checkout and admin, on Vercel + Neon Postgres",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "node scripts/setup-db.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify:orders": "node scripts/verify-order-status.mjs",
    "test:routes": "node scripts/verify-routes.mjs",
    "verify:checkout": "node scripts/verify-checkout-idempotency.mjs",
    "verify:access": "node scripts/verify-order-access.mjs",
    "vercel-build": "node scripts/setup-db.mjs && next build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.11.17",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
