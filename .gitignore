node_modules
.next
.vercel
.env*

# Database dumps.
#
# A dump of this database is the most sensitive artifact this project produces:
# customer names, addresses, phone numbers, the mailing list, and the admin
# password hashes. It must never reach a commit, and a commit is not a mistake
# that deleting the file afterwards undoes.
#
# So it is said twice. `backups/*` covers the default output directory, and
# backups/.gitignore repeats it from the inside, so that neither line is the
# only thing in the way. The two extension rules catch a dump written somewhere
# else with `npm run backup -- --out .`.
backups/*
!backups/.gitignore
*.ndjson
*.pg_dump.sql
# Keys and certificates.
#
# Nothing of this shape belongs in the tree today, and the point of the rule is
# that the day one appears - a service-account file, a certificate pulled down
# to debug TLS, an SSH key copied in to reach a box - it is already ignored
# rather than noticed in a diff by whoever happens to read it. The repository
# is public, so the cost of missing one is not a bad commit, it is a leaked key.
*.pem
*.key
*.p12
*.pfx
id_rsa*
.npmrc
.netrc
